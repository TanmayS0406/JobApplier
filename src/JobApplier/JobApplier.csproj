<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JobApplier</RootNamespace>
    <UserSecretsId>jobapplier-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework: AIAgent abstraction, sessions and workflows. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <!-- Writes the accounts document (.docx) on the Desktop. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Resume gap analysis (Insights): ML.NET for the TF-IDF text features and the K-Means job families. -->
    <PackageReference Include="Microsoft.ML" Version="6.0.0" />
    <!-- ...and Math.NET Numerics for the score-calibration regression and the statistics around it: correlations, standard errors, the Monte-Carlo range of a projection. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobApplier.Tests" />
  </ItemGroup>

</Project>
