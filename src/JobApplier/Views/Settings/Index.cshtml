@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var s = Model.Settings;
}

<section class="card">
    <h2>Claude account @if (Model.Provider == "claude") { <span class="chip chip-good">in use</span> }</h2>
    <p class="muted">
        JobApplier uses your own Claude subscription through the official Claude Code CLI. It never sees your credentials:
        <em>Sign in</em> opens Claude's own OAuth page in your browser and the CLI keeps the tokens.
    </p>
    <div id="claude-account" data-status-url="@Url.Action("ClaudeStatus", "Settings")"
         data-signin-url="@Url.Action("SignIn", "Settings")" data-signout-url="@Url.Action("SignOut", "Settings")"
         data-provider="Claude" data-install-hint="Claude Code CLI not found. Install it from https://claude.com/claude-code, or set its path below.">
        <p id="claude-account-text" class="account-text">Checking...</p>
        <div class="actions">
            <button type="button" class="btn primary" id="claude-signin">Sign in with Claude</button>
            <button type="button" class="btn" id="claude-signout">Sign out</button>
        </div>
    </div>
</section>

<section class="card">
    <h2>Gemini account @if (Model.Provider == "gemini") { <span class="chip chip-good">in use</span> }</h2>
    <p class="muted">
        Run the jobs on Google's Gemini instead of Claude. Pick the easier of the two ways to sign in. JobApplier never sees a Google
        password: the key or the login is kept by the Gemini CLI itself.
    </p>
    <div id="gemini-account" data-status-url="@Url.Action("GeminiStatus", "Settings")"
         data-signin-url="@Url.Action("GeminiSignIn", "Settings")" data-signout-url="@Url.Action("GeminiSignOut", "Settings")"
         data-install-url="@Url.Action("GeminiInstall", "Settings")" data-savekey-url="@Url.Action("GeminiSaveKey", "Settings")"
         data-removekey-url="@Url.Action("GeminiRemoveKey", "Settings")"
         data-provider="Gemini" data-install-hint="Gemini CLI not installed yet - use the Install button below.">
        <p id="gemini-account-text" class="account-text">Checking...</p>

        <div id="gemini-install" class="step" hidden>
            <strong>Step 1 - install the Gemini CLI</strong>
            <p class="muted small">It is not installed on this PC. One click opens a window that installs it (needs Node.js, which this app already uses).</p>
            <div class="actions">
                <button type="button" class="btn primary" id="gemini-install-btn">Install Gemini CLI</button>
                <span id="gemini-install-msg" class="muted small"></span>
            </div>
        </div>

        <div class="step">
            <strong>Option A - paste an API key <span class="chip chip-good">quickest</span></strong>
            <p class="muted small">
                Create a free key at <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer">Google AI Studio</a>
                (sign in with Google, press <em>Create API key</em>), paste it here and press Save. It is checked with Google first, then saved in
                <code>~/.gemini/.env</code>, where the Gemini CLI reads it.
            </p>
            <div class="actions">
                <input id="gemini-key" type="password" class="grow" autocomplete="off" spellcheck="false" placeholder="AIza..." />
                <button type="button" class="btn primary" id="gemini-key-save">Save key</button>
                <button type="button" class="btn ghost" id="gemini-key-remove">Remove saved key</button>
            </div>
            <p id="gemini-key-msg" class="muted small"></p>
        </div>

        <div class="step">
            <strong>Option B - sign in with your Google account</strong>
            <p class="muted small">
                Opens the Gemini CLI. In the window, press <kbd>Enter</kbd> on <em>Login with Google</em>, then choose your account in the browser.
                This page notices the login and closes that window for you.
            </p>
            <div class="actions">
                <button type="button" class="btn" id="gemini-signin">Sign in with Google</button>
                <button type="button" class="btn ghost" id="gemini-signout">Sign out</button>
            </div>
        </div>
    </div>
</section>

<section class="card" id="gmail">
    <h2>Gmail replies <span id="gmail-chip" class="chip" hidden></span></h2>
    <p class="muted">
        Find out which employers answered your applications - <em>received</em>, <em>interview / next step</em>, <em>more information needed</em>,
        <em>rejected</em> or <em>offer</em> - on the dashboard. There is no Google sign-in in this app: Claude reads your Gmail through the
        <strong>Gmail connector of your Claude account</strong>, using read-only search and read tools only (it cannot send, draft, label or delete anything).
    </p>
    <p class="muted small">
        <strong>Privacy:</strong> the text of the mails Claude opens is processed by Claude (Anthropic) under your Claude account, like anything else you ask Claude
        about your mail; it is not sent anywhere else. JobApplier keeps only the sender, subject, a short snippet and the verdict of each reply. Each check uses a
        little of your Claude usage (the model is set in the form below, Haiku by default).
    </p>
    <div id="gmail-account" data-status-url="@Url.Action("Status", "Gmail")" data-connect-url="@Url.Action("Connect", "Gmail")"
         data-enable-url="@Url.Action("Enable", "Gmail")" data-disable-url="@Url.Action("Disable", "Gmail")"
         data-check-url="@Url.Action("Check", "Gmail")" data-clear-url="@Url.Action("ClearReplies", "Gmail")">
        <p id="gmail-text" class="account-text">Checking...</p>

        <div class="step">
            <strong>Step 1 - connect Gmail to your Claude account</strong>
            <p class="muted small">
                Claude must be signed in (the Claude card above). Gmail is added and signed in to Google in Claude, not here:
            </p>
            <ol class="small steps-list">
                <li>Press <em>Open Claude to connect Gmail</em>. A Claude window opens. Wait a few seconds until its prompt appears (your connectors load after it starts), then type <kbd>/mcp</kbd>.</li>
                <li>Choose <em>claude.ai Gmail</em>, then <em>Authenticate</em>, and allow access in the browser tab that opens.</li>
                <li>
                    Or do it on the web: <a href="https://claude.ai/settings/connectors" target="_blank" rel="noopener noreferrer">claude.ai &rarr; Settings &rarr; Connectors</a>,
                    add <em>Gmail</em> and press <em>Connect</em>. Then press <em>Check connection</em> here.
                </li>
            </ol>
            <div class="actions">
                <button type="button" class="btn primary" id="gmail-connect">Open Claude to connect Gmail</button>
                <button type="button" class="btn" id="gmail-verify">Check connection</button>
            </div>
            <p id="gmail-connect-msg" class="muted small"></p>
        </div>

        <div class="step">
            <strong>Step 2 - track replies</strong>
            <p class="muted small">
                Starting tracking has Claude look through your mailbox once, and then again by itself as often as set below (0 = only when you press the button).
                Nothing reads your mailbox until you start it.
            </p>
            <div class="actions">
                <button type="button" class="btn primary" id="gmail-enable">Start tracking replies</button>
                <button type="button" class="btn" id="gmail-check">Check for replies now</button>
                <button type="button" class="btn ghost" id="gmail-disable">Stop tracking</button>
            </div>
            <p id="gmail-msg" class="muted small"></p>
            <p class="small"><a asp-controller="Home" asp-action="Index" asp-fragment="replies">See the replies next to your applications on the Dashboard &rarr;</a></p>
        </div>

        <details class="small gmail-more">
            <summary>More</summary>
            <p class="muted">
                Claude decides which application a mail answers and what it says, so it can be wrong; a doubtful one is shown with a <em>check</em> tag and a wrong match can be removed with
                <em>Not about this job</em>. The replies found are in <code>replies.json</code> in the data folder. If the connection check says the connector needs authentication
                even though Claude lists it as connected, finish signing in to Google as in step 1.
            </p>
            <div class="actions">
                <button type="button" class="btn" id="gmail-rescan" title="Look back to the first application again, for example after a missed check.">Read old mail again</button>
                <button type="button" class="btn ghost" id="gmail-clear">Delete saved replies</button>
            </div>
        </details>
    </div>
</section>

<section class="card">
    <h2>Checks</h2>
    <ul class="checks">
        @foreach (var check in Model.Checks)
        {
            <li class="@(check.Ok ? "ok" : "bad")">
                <span class="check-mark">@(check.Ok ? "OK" : "Missing")</span>
                <strong>@check.Name</strong>
                <span class="muted small">@check.Detail</span>
            </li>
        }
    </ul>
</section>

<form asp-action="Save" method="post">
    <section class="card">
        <h2>Agent</h2>
        <div class="form-grid">
            <label class="wide">AI provider
                <select name="Provider">
                    <option value="claude" selected="@(Model.Provider == "claude")">Claude Code (your Claude subscription)</option>
                    <option value="gemini" selected="@(Model.Provider == "gemini")">Gemini CLI (your Google account or a Gemini API key)</option>
                </select>
                <small>Applies to the next job. Both read the screenshot, search, score, fill the form and ask you for help the same way.
                    With Gemini the result format is requested in the prompt rather than enforced by the CLI.</small>
            </label>
            <label>Claude model
                <input name="Model" value="@s.Model" list="models" placeholder="empty = Claude Code default" />
                <datalist id="models"><option value="sonnet"></option><option value="opus"></option><option value="haiku"></option><option value="fable"></option></datalist>
            </label>
            <label>Effort (Claude only)
                <select name="Effort">
                    @foreach (var level in new[] { "", "low", "medium", "high", "xhigh", "max" })
                    {
                        <option value="@level" selected="@(s.Effort == level)">@(level == "" ? "Model default" : level)</option>
                    }
                </select>
            </label>
            <label>Gemini model
                <input name="GeminiModel" value="@s.GeminiModel" list="gemini-models" placeholder="empty = Gemini CLI default" />
                <datalist id="gemini-models"><option value="gemini-2.5-pro"></option><option value="gemini-2.5-flash"></option></datalist>
            </label>
            <label>Jobs at the same time<input name="MaxParallelJobs" type="number" min="1" max="8" value="@s.MaxParallelJobs" /></label>
            <label>Help timeout (minutes)<input name="HelpTimeoutMinutes" type="number" min="2" max="240" value="@s.HelpTimeoutMinutes" /></label>
        </div>
    </section>

    <section class="card">
        <h2>Reply tracking</h2>
        <div class="form-grid">
            <label>Model that reads the mailbox
                <input name="MailModel" value="@s.MailModel" list="mail-models" placeholder="empty = Claude Code default" />
                <datalist id="mail-models"><option value="haiku"></option><option value="sonnet"></option></datalist>
                <small>A small model is enough for this and uses the least of your Claude usage. It always runs on Claude, whichever AI provider runs the jobs.</small>
            </label>
            <label>Check by itself every (hours)
                <input name="MailAutoCheckHours" type="number" min="0" max="72" value="@s.MailAutoCheckHours" />
                <small>0 = only when you press <em>Check for replies now</em>. Applies once tracking has been started above.</small>
            </label>
        </div>
    </section>

    <section class="card">
        <h2>Browser</h2>
        <div class="form-grid">
            <label>Browser
                <select name="Browser">
                    @foreach (var b in new[] { "chrome", "msedge", "firefox", "webkit" })
                    {
                        <option value="@b" selected="@(s.Browser == b)">@b</option>
                    }
                </select>
            </label>
            <label>Playwright MCP version<input name="PlaywrightMcpVersion" value="@s.PlaywrightMcpVersion" /></label>
            <label class="check wide">
                <input type="checkbox" name="Headless" value="true" @(s.Headless ? "checked" : null) />
                <span><strong>Hide the browser window (headless)</strong>
                    <small>Not recommended: you cannot solve a CAPTCHA in a window you cannot see.</small></span>
            </label>
        </div>
    </section>

    <section class="card">
        <h2>Defaults and files</h2>
        <div class="form-grid">
            <label class="check wide">
                <input type="checkbox" name="DefaultAutoSubmit" value="true" @(s.DefaultAutoSubmit ? "checked" : null) />
                <span><strong>Submit applications automatically by default</strong>
                    <small>When off, every application waits for your approval before the final Submit.</small></span>
            </label>
            <label>Default minimum match %<input name="DefaultMinMatchPercent" type="number" min="0" max="100" value="@s.DefaultMinMatchPercent" /></label>
            <label class="wide">Accounts document (.docx)
                <input name="AccountsDocumentPath" value="@s.AccountsDocumentPath" placeholder="@Model.AccountsDocumentPath" />
                <small>Empty = <code>JobApplier-Accounts.docx</code> on your Desktop.</small>
            </label>
            <label class="wide">Claude CLI path
                <input name="ClaudePath" value="@s.ClaudePath" placeholder="empty = find claude.exe automatically" />
            </label>
            <label class="wide">Gemini CLI path
                <input name="GeminiPath" value="@s.GeminiPath" placeholder="empty = find gemini.cmd automatically" />
            </label>
        </div>
        <p class="muted small">Data folder: <code>@Model.DataFolder</code></p>
    </section>

    <div class="actions"><button class="btn primary" type="submit">Save settings</button></div>
</form>

<section class="card">
    <h2>Accounts document</h2>
    <p>
        <code>@Model.AccountsDocumentPath</code> &middot; @Model.AccountCount account@(Model.AccountCount == 1 ? "" : "s") and
        @Model.ApplicationCount application@(Model.ApplicationCount == 1 ? "" : "s") recorded.
        It lists each account's company, role, site, e-mail and password in plain text - keep it private - and each posting
        applied to with its URL. A new job for a posting listed there is skipped, so you never apply twice.
    </p>
    @if (!string.IsNullOrEmpty(Model.DocumentError))
    {
        <div class="banner banner-error">@Model.DocumentError</div>
    }
    <form asp-action="RebuildDocument" method="post"><button class="btn" type="submit">Rebuild document</button></form>
</section>
