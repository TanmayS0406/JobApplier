@model RepliesViewModel
@{
    var replySorts = new[]
    {
        (ListQuery.SortNewest, "Newest reply first"), (ListQuery.SortMatchHigh, "Match: high to low"), (ListQuery.SortMatchLow, "Match: low to high")
    };
    var replyShows = new[]
    {
        (ListQuery.ShowRejected, "Rejected"), (ListQuery.ShowInfo, "Info requested"), (ListQuery.ShowMoving, "Moving forward"),
        (ListQuery.ShowOffer, "Offer"), (ListQuery.ShowReceived, "Received"), (ListQuery.ShowUnclear, "Unclear")
    };
    var replyBar = new ListBar(Model.Query, Model.Page, replySorts, "replies", Model.Total, replyShows);
    var kinds = new[] { ReplyKind.Offer, ReplyKind.MovingForward, ReplyKind.InfoRequested, ReplyKind.Rejected, ReplyKind.Acknowledged, ReplyKind.Unclear };
}

@if (!Model.Enabled && Model.Total == 0)
{
    <section class="card replies-card" data-checking="false">
        <div class="card-head"><h2>Replies from employers</h2></div>
        <p class="muted">
            See here, next to each application, whether the employer has answered: application received, an interview or next step, a request
            for more information, a rejection or an offer. Claude looks through your Gmail (read-only, through the Gmail connector of your Claude
            account) and it only starts when you press the button. Gmail must be connected to your Claude account first - see the Gmail settings.
        </p>
        <div class="actions">
            <button type="button" class="btn primary" data-gmail-enable>Start tracking replies</button>
            <a class="btn ghost" asp-controller="Settings" asp-action="Index" asp-fragment="gmail">Gmail settings</a>
        </div>
        <p class="muted small" data-gmail-msg></p>
    </section>
}
else
{
    <section class="card replies-card" data-checking="@Model.Checking.ToString().ToLowerInvariant()">
        <div class="card-head">
            <h2>Replies from employers</h2>
            <div class="head-tools">
                @if (Model.Enabled)
                {
                    <span class="muted small">@(Model.LastCheckedUtc is DateTime checkedAt ? "checked " + RelativeTime.Ago(checkedAt) : "not checked yet")</span>
                    <button type="button" class="btn compact" data-gmail-check disabled="@Model.Checking"
                            title="Have Claude look through your mailbox for new answers now. This uses a little of your Claude usage.">@(Model.Checking ? "Checking..." : "Check now")</button>
                }
                else
                {
                    <span class="muted small">tracking is off</span>
                    <button type="button" class="btn compact" data-gmail-enable>Start tracking replies</button>
                }
            </div>
        </div>

        @if (Model.Checking)
        {
            <p class="muted small">Claude is looking through your mailbox now - this can take a minute or two. The answers appear here and in the table below by themselves.</p>
        }
        <p class="muted small" data-gmail-msg></p>

        @if (Model.Enabled && Model.LastError.Length > 0 && !Model.Checking)
        {
            <div class="banner banner-warn">
                The last check did not finish: @Model.LastError
                <a asp-controller="Settings" asp-action="Index" asp-fragment="gmail">Open the Gmail settings</a>.
            </div>
        }

        @if (Model.Total > 0)
        {
            <div class="chips reply-summary">
                @foreach (var kind in kinds)
                {
                    var count = Model.Count(kind);
                    if (count > 0)
                    {
                        <span class="chip @kind.Css()">@count @kind.Label().ToLowerInvariant()</span>
                    }
                }
            </div>

            @if (Model.Total > 1)
            {
                <partial name="_ListBar" model="replyBar" />
            }

            @if (Model.Replies.Count == 0)
            {
                <p class="muted">No reply matches this filter. <button type="button" class="link" data-list-reset>Clear the filter</button></p>
            }

            <ul class="reply-list">
                @foreach (var reply in Model.Replies)
                {
                    <li class="reply">
                        <div class="reply-top">
                            <span class="chip @reply.Kind.Css()">@reply.Kind.Label()</span>
                            @if (!reply.Confident)
                            {
                                <span class="chip chip-unsure" title="The wording pointed two ways (for example a rejection that also mentions an interview). Open the mail to be sure.">check</span>
                            }
                            @if (reply.RepliedUtc is DateTime answeredAt)
                            {
                                <span class="chip reply-sent" title="You answered this mail from here on @answeredAt.ToLocalTime().ToString("f")">you replied @RelativeTime.Ago(answeredAt)</span>
                            }
                            <strong>@reply.Company</strong>
                            @if (reply.Role.Length > 0)
                            {
                                <span class="muted">@reply.Role</span>
                            }
                            @if (Model.MatchByJob.TryGetValue(reply.JobId, out var match))
                            {
                                <span class="chip chip-match" title="How well your resume matches this job">@match% match</span>
                            }
                            <span class="muted small reply-date" title="@reply.ReceivedUtc.ToLocalTime().ToString("f")">@RelativeTime.Ago(reply.ReceivedUtc)</span>
                        </div>
                        <div class="reply-subject">@reply.Subject</div>
                        <div class="muted small">@reply.From</div>
                        @if (reply.Snippet.Length > 0)
                        {
                            <div class="muted small reply-snippet">@reply.Snippet</div>
                        }
                        <div class="small reply-actions">
                            @* The composer is one dialog outside this (self-refreshing) card; this button only tells it which mail it is for. *@
                            <button type="button" class="btn compact" data-reply-compose="@reply.Id"
                                    data-company="@reply.Company" data-role="@reply.Role" data-subject="@reply.AnswerSubject"
                                    data-to="@reply.FromAddress" data-no-reply="@reply.IsNoReply.ToString().ToLowerInvariant()"
                                    data-replied="@(reply.RepliedUtc is DateTime sentAt ? sentAt.ToLocalTime().ToString("f") : "")"
                                    title="Have Claude write an answer to this mail. You read and change it, and nothing is sent until you press Send.">@(reply.RepliedUtc.HasValue ? "Reply again" : reply.DraftBody.Length > 0 ? "Continue draft" : "Reply")</button>
                            &middot;
                            <a href="@reply.GmailLink" target="_blank" rel="noopener noreferrer">Open in Gmail</a>
                            &middot;
                            <button type="button" class="link" data-reply-dismiss="@reply.Id" title="Remove this reply. It will not be matched to a job again.">Not about this job</button>
                            @if (reply.Reason.Length > 0)
                            {
                                <span class="muted">&middot; recognised from &ldquo;@reply.Reason&rdquo;</span>
                            }
                        </div>
                    </li>
                }
            </ul>
            <partial name="_Pager" model="replyBar" />
        }
        else
        {
            <p class="muted">
                No replies yet. @Model.ApplicationCount application@(Model.ApplicationCount == 1 ? " is" : "s are") being watched; an answer shows up here
                as soon as it reaches your mailbox (checked automatically as set in Settings, or press <em>Check now</em>).
            </p>
        }
    </section>
}
