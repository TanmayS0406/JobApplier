@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject JobApplier.Services.SettingsService AppSettingsService
@{
    var useCopilot = JobApplier.Domain.AiProvider.Normalize(AppSettingsService.Current.Provider) == JobApplier.Domain.AiProvider.Copilot;
    var controller = (string?)ViewContext.RouteData.Values["controller"];
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf" content="@csrf" />
    <title>@ViewData["Title"] - JobApplier</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">JobApplier</a>
        <nav>
            <a class="@Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="@Active("Insights")" asp-controller="Insights" asp-action="Index">Insights</a>
            <a class="@Active("Profile")" asp-controller="Profile" asp-action="Index">Profile</a>
            <a class="@Active("Settings")" asp-controller="Settings" asp-action="Index">Settings</a>
            <a href="/hangfire" target="_blank" rel="noopener" title="What is waiting, running, or scheduled for after a usage limit (Hangfire dashboard)">Queue</a>
        </nav>
        <span class="pills">
            <a class="pill pill-unknown @(useCopilot ? "" : "pill-active")" asp-controller="Settings" asp-action="Index" data-provider-pill
               data-status-url="@Url.Action("ClaudeStatus", "Settings")" data-provider="Claude" data-active="@(!useCopilot ? "true" : "false")"
               title="@(useCopilot ? "Claude: not used for jobs (change the AI in Settings). Used for Gmail replies." : "Claude is the AI that runs your jobs.")">Claude: checking...</a>
            <a class="pill pill-unknown @(useCopilot ? "pill-active" : "")" asp-controller="Settings" asp-action="Index" data-provider-pill
               data-status-url="@Url.Action("CopilotStatus", "Settings")" data-provider="Copilot" data-active="@(useCopilot ? "true" : "false")"
               title="@(useCopilot ? "GitHub Copilot is the AI that runs your jobs." : "GitHub Copilot: not used for jobs (change the AI in Settings).")">Copilot: checking...</a>
        </span>
    </header>

    <main class="container">
        @if (TempData["Message"] is string message)
        {
            <div class="banner banner-ok">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="banner banner-error">@error</div>
        }
        @RenderBody()
    </main>

    <div id="busy" class="busy" hidden>
        <div class="busy-box">
            <div class="spinner"></div>
            <p id="busy-text">Working...</p>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
