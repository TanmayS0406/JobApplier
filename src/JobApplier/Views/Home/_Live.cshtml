@model LiveViewModel
@{
    // Totals are over ALL jobs: Model.Rows is only the current page, and "Retry all failed (24)" must count the 24.
    var running = Model.Counts.Running;
    var applied = Model.Counts.Applied;
    var waiting = Model.Counts.Waiting;
    var limited = Model.Counts.Limited;
    var failedAll = Model.Counts.FailedAll;
    var failed = Model.Counts.Failed;
    var jobSorts = new[]
    {
        (ListQuery.SortNewest, "Newest first"), (ListQuery.SortMatchHigh, "Match: high to low"),
        (ListQuery.SortMatchLow, "Match: low to high"), (ListQuery.SortCompany, "Company A-Z")
    };
    var jobBar = new ListBar(Model.Query, Model.Page, jobSorts, "jobs", Model.Counts.Total);
}

@if (Model.PausedUntilUtc is DateTime pausedUntil)
{
    <div class="banner banner-warn">
        <strong>The AI usage limit was reached.</strong>
        Jobs that have not started are waiting and will start by themselves at about @pausedUntil.ToLocalTime().ToString("ddd HH:mm").
    </div>
}

@if (Model.Help.Count > 0)
{
    <section class="needs-you" data-help-count="@Model.Help.Count">
        <h2>Needs you (@Model.Help.Count)</h2>
        @foreach (var item in Model.Help)
        {
            <article class="help-card">
                <header>
                    <strong>@item.Company</strong> <span class="muted">@item.Title</span>
                    <a class="small" asp-controller="Jobs" asp-action="Details" asp-route-id="@item.JobId">details</a>
                </header>
                @await Html.PartialAsync("_Help", item)
            </article>
        }
    </section>
}

<section class="card">
    <div class="card-head">
        <h2>Results</h2>
        @if (Model.Counts.Total > 0)
        {
            <div class="head-tools">
                <span class="muted small">@Model.Counts.Total job@(Model.Counts.Total == 1 ? "" : "s") &middot; @running running &middot; @applied applied@(waiting > 0 ? $" · {waiting} waiting for the limit" : "")</span>
                @if (failedAll > 0)
                {
                    <button type="button" class="btn primary compact" data-retry-open
                            data-retry-action="@Url.Action("RetryAllFailed", "Jobs")"
                            data-retry-title="Retry all @failedAll failed job@(failedAll == 1 ? "" : "s")"
                            data-retry-note="They start a few at a time (see Settings) in the order they were added. Choose how they should apply this time. A job that stopped on a usage limit fails again if the limit has not reset yet - use 'Retry when available' for those."
                            data-retry-go="Retry @failedAll"
                            title="Queue every failed job again, choosing whether to submit automatically and the lowest match worth applying for. Work that already succeeded (reading the screenshot, finding the posting, the match score) is kept.">Retry all failed (@failedAll)</button>
                }
                @if (limited > 0)
                {
                    <button type="button" class="btn compact" data-retry-open
                            data-retry-action="@Url.Action("RetryAllWhenAvailable", "Jobs")"
                            data-retry-title="Retry @limited job@(limited == 1 ? "" : "s") when available"
                            data-retry-note="These stopped because the AI ran out of tokens. Each one is retried by itself once the limit has reset, with the choices below."
                            data-retry-go="Retry when available"
                            title="These stopped because the AI ran out of tokens. They will be retried by themselves once the limit has reset.">Retry when available (@limited)</button>
                }
                @if (failed > 0)
                {
                    <form asp-controller="Jobs" asp-action="ClearFailed" method="post"
                          data-confirm="Delete @failed failed job@(failed == 1 ? "" : "s") and their files? Accounts and the list of applied postings are kept, but a deleted job can no longer be retried.">
                        <button class="btn ghost compact" type="submit">Clear failed (@failed)</button>
                    </form>
                }
            </div>
        }
    </div>

    @if (Model.Counts.Total == 0)
    {
        <p class="muted">Nothing yet. Add some screenshots above.</p>
    }
    else
    {
        @if (Model.Counts.Total > 1)
        {
            <partial name="_ListBar" model="jobBar" />
        }

        @if (Model.Rows.Count == 0)
        {
            <p class="muted">No job matches this filter. <button type="button" class="link" data-list-reset>Clear the filter</button></p>
        }
        else
        {
        <div class="table-wrap">
            <table class="results">
                <thead>
                    <tr>
                        <th>Company / role</th>
                        <th>Location</th>
                        <th class="match-col">Match with your resume</th>
                        <th>Status</th>
                        <th>Employer reply</th>
                        <th>Posting</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>
                                <a class="job-link" asp-controller="Jobs" asp-action="Details" asp-route-id="@row.Id"><strong>@row.Company</strong></a>
                                <div class="muted small">@row.Title</div>
                            </td>
                            <td>@(string.IsNullOrEmpty(row.Location) ? "-" : row.Location)</td>
                            <td class="match-col">
                                @if (row.MatchPercent is int percent)
                                {
                                    <div class="match-cell">
                                        <meter class="match band-@row.MatchBand" min="0" max="100" value="@percent"></meter>
                                        <strong>@percent%</strong>
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="chip status-@row.Status.ToString().ToLowerInvariant()">@row.Status.Label()</span>
                                @if (row.NeedsUser)
                                {
                                    <span class="chip chip-alert">needs you</span>
                                }
                                @if (row.Status == JobStatus.Failed && row.LimitHit)
                                {
                                    <span class="chip chip-limit">@(row.AutoRetry ? "waiting for limit" : "usage limit")</span>
                                    @if (row.AutoRetry && row.RetryAfterUtc is DateTime retryAt)
                                    {
                                        <span class="muted small">retries about @retryAt.ToLocalTime().ToString("ddd HH:mm")</span>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(row.StatusDetail))
                                {
                                    <div class="muted small status-detail">@row.StatusDetail</div>
                                }
                            </td>
                            <td class="reply-cell">
                                @if (Model.Replies.TryGetValue(row.Id, out var reply))
                                {
                                    <a class="chip @reply.Kind.Css()" href="#replies" title="Latest mail from the employer: @reply.Subject">@reply.Kind.Label()@(reply.Confident ? "" : "?")</a>
                                    <div class="muted small reply-line" title="@reply.Subject">@reply.Subject</div>
                                    <div class="muted small">@RelativeTime.Ago(reply.ReceivedUtc)</div>
                                }
                                else if (Model.RepliesTracked && row.Status == JobStatus.Applied)
                                {
                                    <span class="muted small">no reply yet</span>
                                }
                                else
                                {
                                    <span class="muted">-</span>
                                }
                            </td>
                            <td>
                                @if (row.PostingUrl is { Length: > 0 } url && Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == "https" || uri.Scheme == "http"))
                                {
                                    <a href="@uri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(row.Portal) ? uri.Host : row.Portal)</a>
                                }
                                else
                                {
                                    <span class="muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }

        <partial name="_Pager" model="jobBar" />
    }
</section>
